<style>
html { scroll-behavior: smooth; }
.reveal { opacity: 0; transform: translateY(8px); transition: opacity .5s ease, transform .5s ease; }
.reveal.in { opacity: 1; transform: none; }
.card-hover { transition: border-color .15s ease, box-shadow .15s ease; }
.card-hover:hover { border-color: #d1d5db; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
th[data-k] { cursor: pointer; user-select: none; }
canvas { max-height: 280px; max-width: 100%; }
